# --- Django ---
SECRET_KEY=django-insecure-CHANGE-ME-TO-A-RANDOM-VALUE
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# --- Ma'lumotlar bazasi (PostgreSQL) ---
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://botuser:botpassword@127.0.0.1:5432/botdb

# --- Telegram bot ---
# @BotFather dan olingan token
BOT_TOKEN=123456789:AAExampleTokenHere
# Admin(lar)ning Telegram ID raqami(lari), vergul bilan ajratilgan
ADMIN_IDS=111111111,222222222

# --- PDF fayllar ---
# 4 yoki 6 xonali ID bilan boshlanadigan PDF fayllar shu papkada qidiriladi
# (masalan: 123456_natija.pdf). Nisbiy yoki to'liq yo'l bo'lishi mumkin.
TESTPDF_DIR=testpdf

# --- Telegram Mini App (Web App) ---
# HTTPS domen yoki ngrok manzili (masalan: https://your-domain.com/webapp/)
MINI_APP_URL=https://your-domain.com/webapp/

